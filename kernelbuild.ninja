# Kenux Kernel KNE2.7 - Ninja Build System
# Usage: ninja          (build)
#        ninja clean    (clean)

ninja_required_version = 1.10

cc = gcc -Wall -Wextra -Wpedantic -Wshadow -Wcast-align -Wconversion -Wsign-conversion -Wnull-dereference -Wdouble-promotion -Wformat=2 -std=c17 -O2 -g3  
as = nasm
ld = ld

cflags = -m64 -mcmodel=large -ffreestanding -fno-pic -nostdlib -nostartfiles -nodefaultlibs -mno-stack-arg-probe -fno-asynchronous-unwind-tables -fno-unwind-tables
asflags = -f win64
includes = -Iinclude -Ikernel/include -Ikernel/kernel -Ikernel/arch/x86_64/include -Ikernel/lib/libc/include -Iapps/container-os/include -Ikernel/systemd/include -Ikernel/gui/include -Ikal/include
linker_script = kernel/arch/x86_64/boot/linker.ld
builddir = build/kernel

# Rules
rule cc_boot
  command = $cc $cflags $includes -c $in -o $out
  description = CC [boot] $in

rule cc
  command = $cc $cflags $includes -c $in -o $out
  description = CC $in

rule cc_kal
  command = $cc $cflags -DKAL_KERNEL $includes -c $in -o $out
  description = CC [kal] $in

rule nasm
  command = $as $asflags $in -o $out
  description = NASM $in

rule link
  command = gcc -m64 -T $linker_script -nostdlib -nodefaultlibs -nostartfiles "-Wl,-e,_start" -no-pie -o ${out} ${in}
  description = LD ${out}

rule objcopy_bin
  command = objcopy -O binary ${in} ${out}
  description = OBJCOPY ${out}

rule mkdir
  command = cmd /c "if not exist $builddir mkdir $builddir & echo. > $out"
  description = MKDIR $builddir

# Build directory
build $builddir/.dir: mkdir

build $builddir/start64.o: nasm kernel/arch/x86_64/boot/start64.s | $builddir/.dir
build $builddir/boot.o: nasm kernel/arch/x86_64/boot/boot.S | $builddir/.dir
build $builddir/devtmpfs.o: cc kernel/kernel/devtmpfs.c | $builddir/.dir
build $builddir/drivers.o: cc kernel/kernel/drivers.c | $builddir/.dir
build $builddir/epoll.o: cc kernel/kernel/epoll.c | $builddir/.dir
build $builddir/fifo.o: cc kernel/kernel/fifo.c | $builddir/.dir
build $builddir/fs.o: cc kernel/kernel/fs.c | $builddir/.dir
build $builddir/gdb_stub.o: cc kernel/kernel/gdb_stub.c | $builddir/.dir
build $builddir/interrupt.o: nasm kernel/arch/x86_64/interrupt.S | $builddir/.dir
build $builddir/kernel_interrupt.o: cc kernel/kernel/interrupt.c | $builddir/.dir
build $builddir/ipc.o: cc kernel/kernel/ipc.c | $builddir/.dir
build $builddir/kernel.o: cc_boot kernel/kernel/kernel.c | $builddir/.dir
build $builddir/system_init.o: cc kernel/kernel/system_init.c | $builddir/.dir
build $builddir/kthread.o: cc kernel/kernel/kthread.c | $builddir/.dir
