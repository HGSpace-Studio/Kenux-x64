build $builddir/volume.o: cc apps/container-os/src/volume.c | $builddir/.dir

# KAL (Kernel Abstraction Layer)
build $builddir/kal_errno.o: cc_kal kal/src/kal_errno.c | $builddir/.dir
build $builddir/kal_capability.o: cc_kal kal/src/kal_capability.c | $builddir/.dir
build $builddir/kal_marshalling.o: cc_kal kal/src/kal_marshalling.c | $builddir/.dir
build $builddir/kal_registry.o: cc_kal kal/src/kal_registry.c | $builddir/.dir
build $builddir/kal_dispatcher.o: cc_kal kal/src/kal_dispatcher.c | $builddir/.dir
build $builddir/kal_governance.o: cc_kal kal/src/kal_governance.c | $builddir/.dir
build $builddir/kal_ssi.o: cc_kal kal/src/kal_ssi.c | $builddir/.dir
build $builddir/kal_kenux_adapter.o: cc_kal kal/adapters/kenux_adapter.c | $builddir/.dir
build $builddir/kal_builtins.o: cc_kal kal/adapters/kal_builtins.c | $builddir/.dir

# Default target: kernel.elf
build img/boot/kernel.elf.pe: link $builddir/start64.o $builddir/devtmpfs.o $builddir/drivers.o $builddir/epoll.o $builddir/fifo.o $builddir/fs.o $builddir/gdb_stub.o $builddir/interrupt.o $builddir/kernel_interrupt.o $builddir/ipc.o $builddir/kernel.o $builddir/system_init.o $builddir/kthread.o $builddir/module.o $builddir/printk.o $builddir/process.o $builddir/rcu.o $builddir/shell_enhanced.o $builddir/kernel_signal.o $builddir/stacktrace.o $builddir/sync.o $builddir/syscall.o $builddir/sysfs.o $builddir/timer.o $builddir/unixsock.o $builddir/wait.o $builddir/workqueue.o $builddir/cgroup.o $builddir/acpi.o $builddir/acpi_madt.o $builddir/acpi_pm.o $builddir/ahci.o $builddir/apic.o $builddir/bpf.o $builddir/buddy.o $builddir/cfs.o $builddir/efi.o $builddir/efi_entry.o $builddir/ehci.o $builddir/elf.o $builddir/ext2.o $builddir/framebuffer.o $builddir/gui_framebuffer.o $builddir/gui_color.o $builddir/gui_graphics.o $builddir/gui_font.o $builddir/gui_font_data.o $builddir/gui_cjk_font.o $builddir/gui_emoji_font.o $builddir/gui_cursor_data.o $builddir/gui_icon.o $builddir/gui_icon_data.o $builddir/gui_window.o $builddir/gui_widget.o $builddir/gui_window_manager.o $builddir/gui_desktop.o $builddir/gui_msf.o $builddir/gui_kenux_render.o $builddir/gui_terminal.o $builddir/gui_taskmgr.o $builddir/gui_thispc.o $builddir/gui_filemgr.o $builddir/gui_sysinfo.o $builddir/gui_textedit.o $builddir/gui_main.o $builddir/gui_browser.o $builddir/gui_icon_registry.o $builddir/gui_font_ttf_data.o $builddir/gui_kui_draw.o $builddir/gdt.o $builddir/hda.o $builddir/ac97.o $builddir/sound.o $builddir/sound_stubs.o $builddir/hpet.o $builddir/idt.o $builddir/ioapic.o $builddir/jbd2.o $builddir/keyboard.o $builddir/ldso.o $builddir/memory.o $builddir/mmap.o $builddir/net.o $builddir/netfilter.o $builddir/conntrack.o $builddir/tcp_cong.o $builddir/tcp_bbr.o $builddir/nvme.o $builddir/ntfs.o $builddir/registry.o $builddir/pe.o $builddir/win32_kernel32.o $builddir/win32_gdi_and_msg.o $builddir/