ilddir/kapi_notifier.o $builddir/kapi_params.o $builddir/kapi_pci.o $builddir/kapi_random.o $builddir/kapi_rbtree.o $builddir/kapi_rcu.o $builddir/kapi_sched.o $builddir/kapi_security.o $builddir/kapi_seq_file.o $builddir/kapi_skbuff.o $builddir/kapi_smp.o $builddir/kapi_socket.o $builddir/kapi_sort.o $builddir/kapi_string.o $builddir/kapi_time.o $builddir/kapi_vfs.o $builddir/kapi_wait.o $builddir/kapi_crypto_fs.o $builddir/kapi_lvm.o $builddir/kapi_raid.o $builddir/kapi_wireless.o $builddir/kapi_vpn.o $builddir/kapi_netstat.o $builddir/kapi_cpufreq.o $builddir/kapi_namespace.o $builddir/kapi_container.o $builddir/kapi_full_disk_encryption.o $builddir/kapi_iommu.o $builddir/kapi_epoll.o $builddir/kapi_poll.o $builddir/kapi_signalfd.o $builddir/kapi_timerfd.o $builddir/kapi_eventfd.o $builddir/kapi_inotify.o $builddir/kapi_window.o $builddir/kapi_profiler.o $builddir/kapi_lseek.o $builddir/errno.o $builddir/math.o $builddir/math_stubs.o $builddir/setjmp.o $builddir/signal.o $builddir/stdio.o $builddir/stdlib.o $builddir/string.o $builddir/time.o $builddir/unistd.o $builddir/vsprintf.o $builddir/container.o $builddir/image.o $builddir/manager.o $builddir/volume.o $builddir/kal_errno.o $builddir/kal_capability.o $builddir/kal_marshalling.o $builddir/kal_registry.o $builddir/kal_dispatcher.o $builddir/kal_governance.o $builddir/kal_ssi.o $builddir/kal_kenux_adapter.o $builddir/kal_builtins.o
