{
    "name": "green-light",
    "version": "1.0",
    "font": {
        "name": "XJ380F",
        "size": 16
    },
    "colors": {
        "primary": "#006b5c",
        "on_primary": "#ffffff",
        "primary_container": "#78f8de",
        "on_primary_container": "#00201b",
        "secondary": "#006b5c",
        "on_secondary": "#ffffff",
        "secondary_container": "#78f8de",
        "on_secondary_container": "#00201b",
        "tertiary": "#436278",
        "on_tertiary": "#ffffff",
        "tertiary_container": "#c9e6ff",
        "on_tertiary_container": "#001e2f",
        "error": "#ba1a1a",
        "on_error": "#ffffff",
        "error_container": "#ffdad6",
        "on_error_container": "#410002",
        "background": "#fafdfa",
        "on_background": "#191c1b",
        "surface": "#fafdfa",
        "on_surface": "#191c1b",
        "surface_variant": "#dae5e0",
        "on_surface_variant": "#3f4946",
        "inverse_surface": "#2d3130",
        "inverse_on_surface": "#eff1ef",
        "outline": "#6f7976",
        "outline_variant": "#bec9c5",
        "scrim": "#000000",
        "shadow": "#000000"
    },
    "components": {
        "button": {
            "radius": 18,
            "padding": 12,
            "background_color": "primary",
            "color": "on_primary"
        },
        "textbox": {
            "radius": 14,
            "padding": 12,
            "background_color": "surface",
            "border_color": "outline_variant"
        },
        "checkbox": {
            "radius": 7,
            "border_width": 2,
            "border_color": "outline",
            "color": "primary"
        },
        "radio": {
            "radius": 10,
            "border_width": 2,
            "border_color": "outline",
            "color": "primary"
        },
        "panel": {
            "radius": 18,
            "padding": 16,
            "background_color": "surface_variant"
        },
        "code_block": {
            "radius": 12,
            "padding": 12,
            "background_color": "inverse_surface",
            "color": "inverse_on_surface"
        }
    }
}
