{
    "name": "md3-light",
    "version": "1.0",
    "font": {
        "name": "XJ380F",
        "size": 16
    },
    "colors": {
        "primary": "#6750a4",
        "on_primary": "#ffffff",
        "primary_container": "#e9ddff",
        "on_primary_container": "#22005d",
        "secondary": "#625b71",
        "on_secondary": "#ffffff",
        "secondary_container": "#e8def8",
        "on_secondary_container": "#1e192b",
        "tertiary": "#7e5260",
        "on_tertiary": "#ffffff",
        "tertiary_container": "#ffd9e3",
        "on_tertiary_container": "#31101d",
        "error": "#ba1a1a",
        "on_error": "#ffffff",
        "error_container": "#ffdad6",
        "on_error_container": "#410002",
        "background": "#fffbff",
        "on_background": "#1c1b1e",
        "surface": "#fffbff",
        "on_surface": "#1c1b1e",
        "surface_variant": "#e7e0eb",
        "on_surface_variant": "#49454e",
        "inverse_surface": "#313033",
        "inverse_on_surface": "#f4eff4",
        "outline": "#7a757f",
        "outline_variant": "#cac4cf",
        "scrim": "#000000",
        "shadow": "#000000"
    },
    "components": {
        "button": {
            "radius": 20,
            "padding": 12,
            "background_color": "primary",
            "color": "on_primary"
        },
        "textbox": {
            "radius": 12,
            "padding": 12,
            "background_color": "surface",
            "border_color": "outline_variant"
        },
        "checkbox": {
            "radius": 6,
            "border_width": 2,
            "border_color": "outline",
            "color": "primary"
        },
        "radio": {
            "radius": 10,
            "border_width": 2,
            "border_color": "outline",
            "color": "primary"
        },
        "panel": {
            "radius": 16,
            "padding": 16,
            "background_color": "surface_variant"
        },
        "code_block": {
            "radius": 12,
            "padding": 12,
            "background_color": "inverse_surface",
            "color": "inverse_on_surface"
        }
    }
}
