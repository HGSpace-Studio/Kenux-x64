  build/obj/xj380/components/scrollbar.o $
  build/obj/xj380/components/textbox.o $
  build/obj/xj380/components/flex.o $
  build/obj/xj380/platforms/xj380.o

build lib-linux: phony build/libStardustUI-linux.a
build lib-windows: phony build/libStardustUI-windows.a
build lib-xj380: phony build/libStardustUI-xj380.a

default lib-linux
