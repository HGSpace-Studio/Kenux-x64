build build/obj/windows/components/checkbox.o: cxx_windows src/components/checkbox.cpp
build build/obj/windows/components/canvas.o: cxx_windows src/components/canvas.cpp
build build/obj/windows/components/radiobutton.o: cxx_windows src/components/radiobutton.cpp
build build/obj/windows/components/scrollbar.o: cxx_windows src/components/scrollbar.cpp
build build/obj/windows/components/textbox.o: cxx_windows src/components/textbox.cpp
build build/obj/windows/components/flex.o: cxx_windows src/components/flex.cpp
build build/obj/windows/platforms/windows.o: cxx_windows src/platforms/windows.cpp

build build/obj/xj380/file.o: cxx_xj380 src/file.cpp
build build/obj/xj380/network.o: cxx_xj380 src/network.cpp
build build/obj/xj380/sytel.o: cxx_xj380 src/sytel.cpp
build build/obj/xj380/text/font.o: cxx_xj380 src/text/font.cpp
build build/obj/xj380/text/text_renderer.o: cxx_xj380 src/text/text_renderer.cpp
build build/obj/xj380/text/rasterizer/rasterizer.o: cxx_xj380 src/text/rasterizer/rasterizer.cpp
build build/obj/xj380/text/truetype/face.o: cxx_xj380 src/text/truetype/face.cpp
build build/obj/xj380/window.o: cxx_xj380 src/window.cpp
build build/obj/xj380/components/base.o: cxx_xj380 src/components/base.cpp
build build/obj/xj380/components/lable.o: cxx_xj380 src/components/lable.cpp
build build/obj/xj380/components/button.o: cxx_xj380 src/components/button.cpp
build build/obj/xj380/components/checkbox.o: cxx_xj380 src/components/checkbox.cpp
build build/obj/xj380/components/canvas.o: cxx_xj380 src/components/canvas.cpp
build build/obj/xj380/components/radiobutton.o: cxx_xj380 src/components/radiobutton.cpp
build build/obj/xj380/components/scrollbar.o: cxx_xj380 src/components/scrollbar.cpp
build build/obj/xj380/components/textbox.o: cxx_xj380 src/components/textbox.cpp
