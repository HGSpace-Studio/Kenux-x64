build build/obj/xj380/platforms/xj380.o: cxx_xj380 src/platforms/xj380.cpp

build build/libStardustUI-linux.a: archive $
  build/obj/linux/file.o $
  build/obj/linux/network.o $
  build/obj/linux/sytel.o $
  build/obj/linux/text/font.o $
  build/obj/linux/text/text_renderer.o $
  build/obj/linux/text/rasterizer/rasterizer.o $
  build/obj/linux/text/truetype/face.o $
  build/obj/linux/window.o $
  build/obj/linux/components/base.o $
  build/obj/linux/components/lable.o $
  build/obj/linux/components/button.o $
  build/obj/linux/components/checkbox.o $
  build/obj/linux/components/canvas.o $
  build/obj/linux/components/radiobutton.o $
  build/obj/linux/components/scrollbar.o $
  build/obj/linux/components/textbox.o $
  build/obj/linux/components/flex.o $
  build/obj/linux/platforms/linux.o
build build/libStardustUI-windows.a: archive $
  build/obj/windows/file.o $
  build/obj/windows/network.o $
  build/obj/windows/sytel.o $
  build/obj/windows/text/font.o $
  build/obj/windows/text/text_renderer.o $
  build/obj/windows/text/rasterizer/rasterizer.o $
  build/obj/windows/text/truetype/face.o $
  build/obj/windows/window.o $
  build/obj/windows/components/base.o $
  build/obj/windows/components/lable.o $
  build/obj/windows/components/button.o $
  build/obj/windows/components/checkbox.o $
  build/obj/windows/components/canvas.o $
  build/obj/windows/components/radiobutton.o $
  build/obj/windows/components/scrollbar.o $
  build/obj/windows/components/textbox.o $
  build/obj/windows/components/flex.o $
  build/obj/windows/platforms/windows.o
build build/libStardustUI-xj380.a: archive $
  build/obj/xj380/file.o $
  build/obj/xj380/network.o $
  build/obj/xj380/sytel.o $
  build/obj/xj380/text/font.o $
  build/obj/xj380/text/text_renderer.o $
  build/obj/xj380/text/rasterizer/rasterizer.o $
  build/obj/xj380/text/truetype/face.o $
